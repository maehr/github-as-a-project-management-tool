{
  "name": "github-as-a-project-management-tool",
  "description": "Workshop and OER: GitHub as a project management tool for a DH master's thesis",
  "author": "Moritz Mähr (https://github.com/maehr)",
  "url": "https://github.com/maehr/github-as-a-project-management-tool/issues",
  "license": "AGPL-3.0-only",
  "scripts": {
    "check": "prettier --check . && uv run ruff check && uv run ruff format --check && uv run ty check && uv run pytest -q",
    "format": "prettier --write . && uv run ruff format",
    "prepare": "prek install --hook-type pre-commit --hook-type commit-msg",
    "preview": "quarto preview",
    "site:build": "quarto render",
    "site:archive": "uv run python scripts/release_site_archive.py",
    "release:prepare": "npm run site:build && npm run site:archive -- --stage",
    "data:generate": "uv run python src/generate_synthetic_periodicals.py",
    "pages:render": "uv run python src/render_pages.py",
    "screenshots:annotate": "uv run python src/annotate_screenshots.py",
    "changelog": "npm exec git-cliff -- --config cliff.toml",
    "changelog:unreleased": "npm exec git-cliff -- --config cliff.toml --unreleased --strip all",
    "lychee-check": "lychee --config .lycheerc.toml './*.md' './*.qmd' './course/**/*.qmd' './documentation/**/*.qmd' './project-management/**/*.md' './slides/**/*.qmd' './templates/**/*.md'"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.0.2",
    "@j178/prek": "^0.4.4",
    "git-cliff": "^2.13.1",
    "prettier": "^3.8.4"
  },
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "private": true
}
